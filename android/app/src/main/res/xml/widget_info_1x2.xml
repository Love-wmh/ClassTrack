<?xml version="1.0" encoding="utf-8"?>
<!--
  1×2 这一档的 widget 元数据（provider = Cell1x2WidgetReceiver，**维护档**）。

  为什么一档一份：拾取器里的**尺寸标签来自 provider 自己声明的 targetCellWidth/Height**
  （实测：pin 的 extras 会被 launcher 忽略，只有这份声明算数）。2026-09-21 维护面收缩后只有两档
  会出现在拾取器里，但七份元数据都必须与 WidgetProviderRegistry 一一对应 —— 对不上会被
  跨层测试与 check-android-assets.js 拦下。

  **minWidth 特意是 90dp，比其它档的 110dp 小**：它是 Android 12 以下 launcher 的尺寸基准，写成
  110dp（约等于两列宽）会让这一档被撑成两列，用户就看不到「1 列」了。minHeight 仍沿用 110dp ——
  高度方向一列就是一格，没有这个问题。

  resizeMode 两个方向都放开：尺寸只影响字号与间距（样式本身不再随尺寸变）。

  previewLayout / previewImage：都由 scripts/generate-widget-preview-layouts.py 与
  generate-widget-preview-images.py 生成，务必在度量或默认样式变化时重跑（否则会撒谎）。
  configure / widgetFeatures 与其它档一致。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.classtrack.app.widget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/class_track_widget_initial"
    android:minHeight="110dp"
    android:minWidth="60dp"
    android:previewImage="@drawable/widget_preview_1x2"
    android:previewLayout="@layout/widget_preview_1x2"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="1"
    android:updatePeriodMillis="1800000"
    android:widgetFeatures="reconfigurable" />
