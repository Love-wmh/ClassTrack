<?xml version="1.0" encoding="utf-8"?>
<!--
  覆盖 Glance 内部的列表容器布局（同名资源：app 侧优先于库）。

  Glance 的 `LazyColumn` 底层就是这个 `ListView`（见 glance-appwidget-1.2.0 的 res/layout/glance_list.xml），
  而它的 style `Glance.AppWidget.List` 只设了 `ellipsize`，**没有**关滚动条 —— 于是 Android 给 ListView 的
  默认纵向滚动条会在手指滑动时淡入，正好压住课程行的右端（时间/教室所在的位置）。小工具只有几行内容，
  滚动条没有任何导航价值，只是遮挡，因此这里显式关掉。

  版本耦合提醒：这份布局是 `glance-appwidget 1.2.0` 的 `glance_list.xml` 逐字拷贝，只多了
  `android:scrollbars="none"`。升级 Glance 时必须重新对照上游那份文件（若新增了属性要同步过来），
  否则会丢掉上游的改动。用 `diff <(unzip -p <aar> res/layout/glance_list.xml) <本文件>` 对照。
-->
<ListView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:glance_isTopLevelLayout="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:listSelector="@android:color/transparent"
    android:divider="@null"
    android:scrollbars="none"
    android:theme="@style/Glance.AppWidget.Theme.ListChildren"
    style="@style/Glance.AppWidget.List" />
