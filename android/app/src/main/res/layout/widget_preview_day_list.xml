<?xml version="1.0" encoding="utf-8"?>
<!--
  预览示意图（静态 mock）：同时用于
  1. appwidget-provider 的 android:previewLayout —— Android 12+ 的桌面小工具选择器会渲染它，
     让用户在选择器里看到小工具真实的长相，而不是一个 App 图标；
  2. 配置页里三种样式的缩略图。

  **只能用 RemoteViews 白名单内的类**（FrameLayout / LinearLayout / TextView / ImageView 等）。
  这里曾经出现过 <View> 子节点，launcher 在 inflate 时抛
  `InflateException: Class not allowed to be inflated android.view.View`，桌面直接显示「Can't load widget」。

  这份 mock 是**静态的**：改动真实样式的视觉时必须同步更新它，否则预览会撒谎（见 design.md D14）。
  文案来自 @string/widget_preview_*，是示例课程，不是任何用户数据。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_preview_surface"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_summary"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_style_entry"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_time_1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_name_1"
            android:textColor="@color/widget_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_room_1"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_time_2"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_name_2"
            android:textColor="@color/widget_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_room_2"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_live_mark"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_time_3"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_name_3"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_room_3"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
