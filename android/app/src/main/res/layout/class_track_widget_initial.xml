<?xml version="1.0" encoding="utf-8"?>
<!--
  appwidget-provider 的 initialLayout 是必填项：它在 Glance 完成第一次合成之前短暂显示。
  这里刻意只放一个带圆角的纯色块，不放任何文字 —— 真正的文案全部由 Glance 渲染，
  避免出现「占位文案一闪而过」的观感问题。

  注意：这与 previewLayout 不是一回事。previewLayout 需要一份完整的传统 RemoteViews 布局，
  收益只有小工具选择器里的预览像素，本任务刻意不实现（见 design.md D7）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_surface"
    android:padding="12dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface" />
</FrameLayout>
