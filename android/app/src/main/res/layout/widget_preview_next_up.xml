<?xml version="1.0" encoding="utf-8"?>
<!--
  选择器预览示意图（静态 mock）：**默认样式「接下来」**的长相。

  用法：`appwidget-provider` 的 `android:previewLayout`。Android 12+ 的选择器会渲染这份布局，
  让用户在选择器里看到小工具真实的长相，而不是一个 App 图标（R10）。

  为什么是「接下来」而不是别的样式：默认样式就是它（`WidgetStyleConfig.DEFAULT_LAYOUT_STYLE`），
  选择器要给的是「放下去会得到什么」。换了默认样式就必须同步换掉这份 mock，否则预览会撒谎。

  **只能用 RemoteViews 白名单内的类**（FrameLayout / LinearLayout / TextView / ImageView 等）。
  这里曾经出现过 <View> 子节点，launcher 在 inflate 时抛
  `InflateException: Class not allowed to be inflated android.view.View`，桌面直接显示「Can't load widget」。
  同理不要用 `Space` —— 间距一律用 layout_marginTop。

  这份 mock 是**静态的**：改动真实渲染的视觉时必须同步更新它（以及 scripts/generate-widget-preview.py
  生成的示意图），否则预览会撒谎（见 design.md D14）。文案来自 @string/widget_preview_*，是示例课程，
  不是任何用户数据。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_preview_surface"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- hero 标签行：状态标签 +「样式」入口（与运行期一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_hero_label"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_style_entry"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- hero 课程名：真实渲染只给一行 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_hero_name"
        android:textColor="@color/widget_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_hero_time"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <!-- 汇总行：与 hero 之间留 6dp（运行期是 hero 末尾的 Spacer） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_preview_summary"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_style_entry"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 课表首行：距汇总行 6dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_time_1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_name_1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_room_1"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_time_2"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_name_2"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_room_2"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
