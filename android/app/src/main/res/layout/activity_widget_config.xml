<?xml version="1.0" encoding="utf-8"?>
<!--
  widget 配置页（放置时由 launcher 打开，之后可从 widget 内的「样式」入口再次打开）。

  **这里刻意不引用任何课程数据**：页面只出现样式名、说明文字与静态示意图，
  因此即使该 Activity 被第三方应用拉起，也读不到用户的课表。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_config_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_config_intro"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_config_preset_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/widget_preset_hint_background"
            android:padding="10dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_config_layout_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/widget_config_layout_section"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/widget_config_layout_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">


            <RadioButton
                android:id="@+id/widget_config_layout_day_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_layout_day_list" />

            <TextView
                android:id="@+id/widget_config_layout_day_list_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="@string/widget_config_layout_day_list_desc"
                android:textSize="12sp" />

            <!-- 预览由 WidgetConfigActivity 填入真实合成结果（见 design.md D14），不再是静态 mock -->
            <FrameLayout
                android:id="@+id/widget_config_preview_day_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="6dp" />

            <RadioButton
                android:id="@+id/widget_config_layout_next_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/widget_config_layout_next_up" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="@string/widget_config_layout_next_up_desc"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/widget_config_preview_next_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="6dp" />

            <RadioButton
                android:id="@+id/widget_config_layout_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/widget_config_layout_compact" />

            <TextView
                android:id="@+id/widget_config_layout_compact_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="@string/widget_config_layout_compact_desc"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/widget_config_preview_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="6dp" />
        </RadioGroup>


        <!--
            二级区入口：一级只留「接下来」（本轮收缩后的核心摆法），其余样式与两组选项默认折叠。
            为什么不放在 RadioGroup 里：它是折叠开关而不是一个选项 —— 混进单选组会被当成可选项。
        -->
        <TextView
            android:id="@+id/widget_config_advanced_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/widget_config_advanced_expand"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!--
            二级区内容。默认 `gone`；若实例的配置落在这一区里，进页面会自动展开（不让用户以为设置丢了）。
            注意「全天课表 / 紧凑」两个单选项仍在上面那个 RadioGroup 里（必须留在同一组才有互斥语义），
            折叠时由代码单独把它们的控件一起收起。
        -->
        <LinearLayout
            android:id="@+id/widget_config_advanced_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
        <TextView
            android:id="@+id/widget_config_finished_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/widget_config_finished_section"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/widget_config_finished_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/widget_config_finished_show_dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_finished_show_dim" />

            <RadioButton
                android:id="@+id/widget_config_finished_hide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_finished_hide" />

            <RadioButton
                android:id="@+id/widget_config_finished_collapse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_finished_collapse" />
        </RadioGroup>

        <TextView
            android:id="@+id/widget_config_finished_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/widget_config_finished_ineffective"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_config_wide_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/widget_config_wide_section"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/widget_config_wide_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/widget_config_wide_adaptive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_wide_adaptive" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="@string/widget_config_wide_adaptive_desc"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/widget_config_wide_dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_wide_dense" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="@string/widget_config_wide_dense_desc"
                android:textSize="12sp" />

        </RadioGroup>

        <TextView
            android:id="@+id/widget_config_wide_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/widget_config_wide_ineffective"
            android:textSize="12sp"
            android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_config_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_cancel" />

            <Button
                android:id="@+id/widget_config_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_config_confirm" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
