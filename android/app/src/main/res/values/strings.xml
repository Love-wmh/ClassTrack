<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">ClassTrack</string>
    <string name="title_activity_main">ClassTrack</string>
    <string name="package_name">com.classtrack.app</string>
    <string name="custom_url_scheme">com.classtrack.app</string>

    <!-- 桌面小工具 -->
    <string name="widget_label">ClassTrack 课程</string>
    <string name="widget_description">在桌面上显示今天一整天的课程、正在进行的那一节，以及下一节在什么时候</string>

    <!-- 「接下来」的标签 -->
    <string name="widget_hero_in_progress">正在进行</string>
    <string name="widget_hero_upcoming">接下来 · 第 %1$s 节</string>
    <string name="widget_hero_upcoming_other_day">接下来 · %1$s</string>

    <!-- 时间与教室 -->
    <string name="widget_time_range">%1$s - %2$s</string>
    <string name="widget_time_and_room">%1$s · %2$s</string>

    <!-- 全天课表与计数：三种样式共用 -->
    <string name="widget_day_summary">今天 %1$s · 共 %2$d 节</string>
    <string name="widget_day_summary_no_weekday">今天 · 共 %1$d 节</string>
    <string name="widget_day_no_class">今天已无课</string>
    <!-- 今天本来就没有课（周末/假期），与「今天已无课」区分；两者都不能说成「明天有课」 -->
    <string name="widget_day_empty">今天无课</string>
    <!-- 今天没课但明天有课时，列表是明天的，汇总行必须写明「明天」，不能冒充今天 -->
    <string name="widget_day_summary_tomorrow">明天 %1$s · 共 %2$d 节</string>
    <string name="widget_day_summary_tomorrow_no_weekday">明天 · 共 %1$d 节</string>
    <string name="widget_tomorrow_count">明天 %1$d 节</string>
    <string name="widget_finished_count">已上完 %1$d 节</string>
    <string name="widget_today_remaining_count">今天还有 %1$d 节</string>
    <!-- 双栏富内容（静态数据，不需要额外刷新） -->
    <string name="widget_counts_summary">已上完 %1$d 节 · 还有 %2$d 节</string>
    <string name="widget_mid_next">下一节 %1$s %2$s</string>
    <string name="widget_mid_next_second">再下一节 %1$s %2$s</string>
    <!-- hero 本身就是「接下来」那一节时，它之后的课要再退一级称呼，否则会出现「接下来 A / 下一节 B」这种自相矛盾的读法。 -->
    <string name="widget_mid_next_third">再之后 %1$s %2$s</string>
    <string name="widget_footer_last">今天最后一节 %1$s %2$s</string>
    <string name="widget_next_other_day_line">下一节 · %1$s %2$s %3$s</string>
    <string name="widget_style_entry">样式</string>
    <string name="widget_sections_suffix">第%1$s节</string>

    <!-- 没有任何可展示课程时的引导文案：五种原因必须分开，避免误导用户 -->
    <string name="widget_prompt_sync">打开 ClassTrack 同步课表到桌面</string>
    <string name="widget_prompt_set_semester">请先在 ClassTrack 里设置学期开始日期</string>
    <string name="widget_prompt_import">暂无课表数据，打开 ClassTrack 导入</string>
    <string name="widget_prompt_stale">课表数据已过期，请打开 ClassTrack 同步</string>
    <string name="widget_no_upcoming">本学期课程已结束</string>

    <!-- 小工具设置页（精度等级） -->
    <string name="widget_precision_title">桌面小工具</string>
    <string name="widget_precision_level_basic">基础</string>
    <string name="widget_precision_level_exact">精确</string>
    <string name="widget_precision_basic_hint">基础模式不需要任何特殊权限；息屏深度省电时，课程切换最长可能延迟约 30 分钟，但显示的课程名始终正确。</string>
    <string name="widget_precision_exact_hint">精确模式已开启：课程开始/结束时即使设备在休眠中也会按点切换。</string>
    <string name="widget_precision_enable">开启精确切换</string>
    <string name="widget_precision_granted">已开启精确切换</string>
    <string name="widget_precision_open_settings">前往系统设置</string>
    <string name="widget_precision_unavailable">当前系统版本不需要该权限。</string>

    <!-- 配置页（放置时或从 widget 内的「样式」入口打开） -->
    <string name="widget_config_title">小工具样式</string>
    <!-- 应用内「添加到桌面」按预设打开配置页时的提示。文案里只出现格子的尺寸与「可修改」，不承诺任意尺寸都完美。 -->
    <string name="widget_config_preset_hint">已按推荐预设预填（推荐 %1$s 格子）。放好后可以随意改，拖到别的尺寸也能用。</string>
    <string name="widget_config_intro">样式按这个小工具实例单独保存，桌面上可以放多个样式不同的实例。</string>
    <string name="widget_config_layout_section">布局样式</string>
    <string name="widget_config_layout_day_list">全天课表</string>
    <string name="widget_config_layout_day_list_desc">列出今天一整天的课，正在上的那节高亮；今天没课时改列明天的课，格子放不下时可以上下滑动看完整天。</string>
    <string name="widget_config_layout_next_up">接下来</string>
    <string name="widget_config_layout_next_up_desc">顶部大卡片突出正在进行或接下来的一节课，下方接课表；今天没课时改接明天的课。</string>
    <string name="widget_config_layout_compact">紧凑</string>
    <string name="widget_config_layout_compact_desc">只显示正在进行或接下来的一节课，另加一行今天的节数。</string>
    <string name="widget_config_finished_section">今天已上完的课</string>
    <string name="widget_config_finished_show_dim">灰显保留</string>
    <string name="widget_config_finished_hide">不显示</string>
    <string name="widget_config_finished_collapse">折叠成一行计数</string>
    <string name="widget_config_finished_ineffective">「紧凑」样式不显示课程列表，所以这个选项对它没有效果。</string>
    <string name="widget_config_wide_section">大格子表现</string>
    <string name="widget_config_wide_adaptive">跟随尺寸</string>
    <string name="widget_config_wide_adaptive_desc">字号与间距随格子大小一起放大；小格子上与以前完全一致。</string>
    <string name="widget_config_wide_dense">信息加密</string>
    <string name="widget_config_wide_dense_desc">在放大的基础上，课名放宽到两行，课程行补「第几节」，汇总行补当天已上完的节数。</string>
    <string name="widget_config_wide_two_column">双栏</string>
    <string name="widget_config_wide_two_column_desc">左栏放当前或接下来的一节课，右栏放当天课表；格子不够宽时自动保持单栏。</string>
    <string name="widget_config_wide_ineffective">「紧凑」样式不显示课程列表，所以这个选项对它没有效果。</string>
    <string name="widget_config_confirm">确定</string>
    <string name="widget_config_cancel">取消</string>

    <!-- 预览示意图里的示例课程：只是静态 mock，不是任何用户数据；三份示意图复用同一批 -->
