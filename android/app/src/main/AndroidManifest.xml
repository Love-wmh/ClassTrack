<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".CourseImportActivity"
            android:exported="false"
            android:label="应用内导入课程表"
            android:screenOrientation="unspecified"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density" />

        <!--
            小工具样式配置页（R8）。

            必须 exported="true"：放置 widget 时由 launcher 拉起，之后 widget 内的「样式」入口也会用它。
            因此 EXTRA_APPWIDGET_ID 一律按不可信输入处理（校验存在性与 provider 归属，否则 RESULT_CANCELED），
            且页面不渲染任何课程数据 —— 详细边界见 WidgetConfigActivity 的类注释。
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          桌面小工具的七个 provider（**两档维护 + 五档收起**），每个尺寸一个：
          维护档 = 3×2「接下来」与 1×2「紧凑」—— 只有这两个会出现在系统拾取器里；
          收起档 = 2×2 / 2×3 / 4×2 / 4×3 / 6×3 —— 应用启动时被 `WidgetProviderScopeGate` 禁用（组件
          禁用即从拾取器消失），但**类、清单与元数据一律保留**：桌面上可能还留着这些尺寸的实例，
          而配置页的归属校验（`WidgetProviders.isOurs`）也必须继续认它们。

          为什么按尺寸注册多个：pin 的尺寸提示（OPTION_APPWIDGET_MIN_WIDTH/HEIGHT）会被 launcher 忽略
          （实测 Launcher3 只认 provider 自己的 targetCellWidth/Height），而**拾取器里的尺寸标签来自
          provider 声明**。因此"让用户按尺寸选"只能靠多注册 provider —— 顺带还绕开了 pin 这条不可靠的路：
          用户从拾取器拖放，放下即带对应样式，不依赖确认回调（真机 ColorOS 会静默丢掉 pin 请求）。

          五个 receiver 共用同一个 `ClassTrackWidget`（渲染逻辑不复制）；差异只在各自的
          `android:label`（拾取器里显示的名字）与 meta-data 指向的元数据文件。
          **4×3 那个沿用旧类名 `ClassTrackWidgetReceiver`**：改名会让桌面上已有的实例全部失效
          （系统按组件名找回 provider）。

          exported=true 是 AppWidget 框架的硬要求：小工具宿主（launcher / 系统）必须能向我们投递
          ACTION_APPWIDGET_UPDATE。这些接收器只读取本应用私有偏好并更新自己的 widget，不接受任何
          外部输入数据，因此导出不构成数据暴露面。
        -->
        <receiver
            android:name=".widget.ClassTrackWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_4x3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_4x3" />
        </receiver>

        <receiver
            android:name=".widget.Cell2x2WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x2" />
        </receiver>

        <receiver
            android:name=".widget.Cell2x3WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_2x3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x3" />
        </receiver>

        <receiver
            android:name=".widget.Cell3x2WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_3x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_3x2" />
        </receiver>

        <receiver
            android:name=".widget.Cell1x2WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_1x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_1x2" />
        </receiver>

        <receiver
            android:name=".widget.Cell4x2WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_4x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_4x2" />
        </receiver>

        <receiver
            android:name=".widget.Cell6x3WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_6x3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_6x3" />
        </receiver>

        <!--
          L2：跨零点 / 用户改时间 / 换时区。这三个广播在处理系统的隐式广播豁免清单内，
          因此可以声明在 manifest 上并被投递，且与 targetSdk 无关。exported=false 即可：
          投递方是系统，不需要对外导出。
        -->
        <!--
          「添加到桌面」的确认回调。**不导出**：系统是经由我们创建的 PendingIntent 投递这个广播的，
          PendingIntent 的语义就是"以我们的身份发送"，因此无需 exported，外部应用也无法伪造
          （伪造也无法得到实例 id：id 由系统在确认时填入）。
        -->
        <receiver
            android:name=".widget.WidgetPinResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.WidgetTimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          L3：精确边界闹钟的落点。只由本应用自己的 PendingIntent 触发，因此 exported=false；
          外部应用即使知道 action 名也无法投递（Android 12+ 对未导出接收器的隐式广播投递限制，
          加上这里没有 intent-filter，只能被显式 Intent 命中）。
        -->
        <receiver
            android:name=".widget.WidgetBoundaryAlarmReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      桌面小工具的 L3 精确模式（用户可选增强）。
      Android 12+ 起这是「特殊应用访问」，Android 14+ 对新安装应用默认拒绝，
      必须由用户在系统设置里显式授予；未授予时小工具静默回退到 WorkManager + 系统 30 分钟兜底。
      刻意**不**声明 USE_EXACT_ALARM：它只面向闹钟/日历类应用，会自动授予，不适用于本场景。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
